# Variables lues par l'application. Aucune valeur ici n'est secrète : ce fichier se copie en
# .env pour le développement local. Il est complété au fil des itérations, à mesure que
# l'application lit de nouvelles variables (base de données, etc.).

# --- api/ ---
# Port d'écoute du service api. Le conteneur publié impose 8081 (voir api/Dockerfile) ;
# utile pour lancer l'api en dehors du conteneur, en développement.
PORT=8081
